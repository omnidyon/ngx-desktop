{
  "name": "ngx-desktop",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve examples",
    "build": "ng build ngx-desktop",
    "watch": "ng build ngx-desktop --watch --configuration development",
    "test": "ng test ngx-desktop --watch=false",
    "test:examples": "ng test examples --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,json}\"",
    "publish:lib": "bash ./publish-lib.sh",
    "publish:dry-run": "npm run lint && npm test && npm run build && npm publish ./dist/ngx-desktop --dry-run"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.25",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
